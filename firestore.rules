rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return isRole('administrator');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isRole('tax-collector') || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Admins manage all users; users may update limited self fields (name, lastLogin, devices via subcollection helpers)
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && onlySelfSafeFields());

      function onlySelfSafeFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'lastLogin', 'passwordUpdatedAt', 'mustChangePassword']);
      }

      match /devices/{deviceId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    match /ssoAccessRequests/{requestId} {
      // Pending SSO applicants may create a request while authenticated via Google (or admin)
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    match /passwordAdminActions/{actionId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /remittance_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isRole('remittance-manager');
    }
  }
}
