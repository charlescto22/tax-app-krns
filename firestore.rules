rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return isRole('administrator');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isRole('tax-collector') || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Admins manage users; allow one-time self profile create (bootstrap / first login)
      allow create: if isAdmin() || selfBootstrapCreate(userId);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && onlySelfSafeFields());

      function selfBootstrapCreate(userId) {
        return isAuthenticated()
          && request.auth.uid == userId
          && !exists(/databases/$(database)/documents/users/$(userId))
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'active'
          && (
            request.resource.data.role in ['tax-collector', 'remittance-manager']
            || (
              request.resource.data.role == 'administrator'
              && request.auth.token.email == 'demo.admin@iec-tax.test'
            )
          );
      }

      function onlySelfSafeFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'lastLogin', 'passwordUpdatedAt', 'mustChangePassword']);
      }

      match /devices/{deviceId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    match /ssoAccessRequests/{requestId} {
      // Pending SSO applicants may create a request while authenticated via Google (or admin)
      allow create: if isAuthenticated();
      allow read: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    match /passwordAdminActions/{actionId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /remittance_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isRole('remittance-manager');
    }
  }
}
